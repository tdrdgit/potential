# ---------------------------------------------------------------------------
# Aruba Email MCP server — configuration
# Copy to `.env` (local) or set these as SECRETS on your host. NEVER commit .env.
# ---------------------------------------------------------------------------

# Public HTTPS base URL where this server is reachable (OAuth issuer).
# No trailing slash. Must match the domain you add in claude.ai.
PUBLIC_BASE_URL=https://mail-mcp.example.com

# --- Aruba mailbox credentials (server-side only, never sent to Claude) ------
ARUBA_EMAIL=you@yourdomain.it
ARUBA_PASSWORD=your-mailbox-password

# Aruba defaults — change only if your plan uses different endpoints.
ARUBA_IMAP_HOST=imaps.aruba.it
ARUBA_IMAP_PORT=993
ARUBA_SMTP_HOST=smtps.aruba.it
ARUBA_SMTP_PORT=465

# IMAP folder names used for drafts / sent (locale-dependent on some servers).
ARUBA_DRAFTS_FOLDER=Drafts
ARUBA_SENT_FOLDER=Sent

# --- Connector access gate ---------------------------------------------------
# Password you must type on the OAuth consent screen to authorize a client.
# This is what protects the public URL from anyone who finds it.
ADMIN_LOGIN_PASSWORD=choose-a-strong-passphrase

# Secret used to sign OAuth tokens. MUST stay stable across restarts, otherwise
# clients get logged out. On Render this is generated & kept for you (render.yaml).
# Locally you can set any long random string (or leave empty for an ephemeral one).
OAUTH_SIGNING_KEY=

# --- Runtime ----------------------------------------------------------------
# Where the OAuth token/client SQLite database is stored (mount a volume here).
DATA_DIR=./data
HOST=0.0.0.0
PORT=8000
